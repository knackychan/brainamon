# Brainamon — API keys
# Copy this file to ".env" (same folder) or set the keys in-app via the
# Settings dialog, which uses protected local storage on Windows. .env is gitignored.

# Anthropic / Claude — AI describe, auto-categorize, video analysis
ANTHROPIC_API_KEY=

# OpenAI — audio transcription + the "openai" video-analysis provider
OPENAI_API_KEY=

# Google sign-in app for Backup & phones. An OAuth client of type
# "Desktop app" with the Drive API enabled. Packaging bundles these app OAuth values
# (and the web client ID below), never the whole .env or personal API keys.
BRAINAMON_GOOGLE_CLIENT_ID=
BRAINAMON_GOOGLE_CLIENT_SECRET=
# The phone app's sign-in (same Google project): an OAuth client of type "Web application" whose
# authorized redirect URI is the phone page (http://localhost:18765/mobile.html while developing).
BRAINAMON_GOOGLE_WEB_CLIENT_ID=

# Contributor installers never read this file or ambient OAuth values. Pass your own
# registration JSON explicitly with packaging/build.py --contributor --contributor-oauth.
# Contributor Android debug uses app.brainamon.mobile.contributor and your own local key;
# register that package/certificate in the same Google project as your desktop client.

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name=".SyncProviderProbe" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".SyncProbeReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <provider android:name=".SyncProbeDocuments" android:authorities="${applicationId}.syncfixture" android:exported="true" android:permission="android.permission.MANAGE_DOCUMENTS" android:grantUriPermissions="true">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
    <instrumentation android:name="app.brainamon.mobile.SyncProbe" android:targetPackage="${applicationId}" android:label="Isolated sync checks" />
</manifest>
